# 复制为 .env 后按需填写真实密钥；本示例的所有值必须保持为空。
# .env 已被 Git 忽略，真实密钥只填本地 .env。
# 下列变量名供 config/manual.json 的 key_ref 引用，例如：
# "key_ref": "env:DASHSCOPE_API_KEY"
# 当前内置 DeepSeek、OpenAI；其他厂商需另配 base_url、protocol 和模型 ID。
# 当前协议为 openai-chat，接入时须使用兼容的 Chat Completions 接口。
# 各平台的区域、产品及套餐密钥可能不同，按对应官方文档选择。

# ---------- 国内模型厂商 ----------

# DeepSeek
# https://api-docs.deepseek.com/
DEEPSEEK_API_KEY=

# 阿里云百炼 / 千问（Qwen）
# https://help.aliyun.com/zh/model-studio/compatibility-of-openai-with-dashscope
DASHSCOPE_API_KEY=

# 月之暗面 / Kimi（Moonshot）
# https://platform.kimi.ai/docs/overview
MOONSHOT_API_KEY=

# 智谱 / GLM
# https://docs.bigmodel.cn/cn/guide/start/quick-start
ZHIPUAI_API_KEY=

# 字节跳动 / 豆包、Seed（火山方舟）
# https://docs.volcengine.com/docs/ark/quick-start?lang=zh
ARK_API_KEY=

# 百度 / 文心（ERNIE，千帆 API v2 的 Bearer API Key）
# https://cloud.baidu.com/doc/qianfan-api/s/Dmba8k71y
QIANFAN_API_KEY=

# 腾讯 / 混元（OpenAI 兼容接口的 API Key）
# https://cloud.tencent.com/document/product/1729/111007
HUNYUAN_API_KEY=

# MiniMax
# https://platform.minimax.io/docs/guides/quickstart-preparation
MINIMAX_API_KEY=

# 阶跃星辰 / StepFun
# https://platform.stepfun.com/cookbook/step-5-reasoning
STEP_API_KEY=

# 讯飞 / 星火（HTTP 接口的 APIPassword）
# https://www.xfyun.cn/doc/spark/HTTP%E8%B0%83%E7%94%A8%E6%96%87%E6%A1%A3.html
SPARK_API_PASSWORD=

# ---------- 国外模型厂商 ----------

# OpenAI / GPT
# https://developers.openai.com/api/docs/quickstart
OPENAI_API_KEY=

# Anthropic / Claude
# https://platform.claude.com/docs/en/get-api-key
ANTHROPIC_API_KEY=

# Google / Gemini
# https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=

# xAI / Grok
# https://docs.x.ai/developers/quickstart
XAI_API_KEY=

# Mistral AI
# https://docs.mistral.ai/getting-started/quickstarts/developer/first-api-request
MISTRAL_API_KEY=

# Cohere / Command
# https://docs.cohere.com/docs/retrieval-augmented-generation-rag
CO_API_KEY=

# ---------- 模型聚合与推理平台 ----------

# 硅基流动 / SiliconFlow（使用平台签发的密钥）
# https://docs.siliconflow.cn/docs/userguide/quickstart
SILICONFLOW_API_KEY=

# OpenRouter（使用平台签发的密钥）
# https://openrouter.ai/developers
OPENROUTER_API_KEY=

# Groq（使用平台签发的密钥）
# https://console.groq.com/docs/quickstart
GROQ_API_KEY=
