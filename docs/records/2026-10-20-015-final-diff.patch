+    assert_eq!(
+        built.message,
+        rebuild_ctx(&cwd, Some("/bin/sh"), T0_DATE, Some("仅全局G\n"), &[])
+    );
+    assert!(!built.message.contains(&format!("instructions for {cwd}")));
+
+    // SHELL 缺失与纯空白：整行省略
+    for shell in [None, Some("  \t ")] {
