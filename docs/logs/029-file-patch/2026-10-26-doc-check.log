assert '"'"'- 更新时间：2026-10-26'"'"' in spec
assert '"'"'### 3.2 根据规格制定的实施计划'"'"' in spec
assert len(re.findall(r'"'"'^\| A\d+ \|'"'"', spec, re.M)) == 12
assert all('"'"'待测'"'"' in row for row in spec.splitlines() if re.match(r'"'"'^\| A\d+ \|'"'"', row))
assert len(list((root / '"'"'docs/specs'"'"').glob('"'"'029-*.md'"'"'))) == 1
print(f'"'"'OK 本地链接总数: {checked}'"'"')
print('"'"'OK 029 编号唯一、规格固定五节、实施计划完整、A1–A12 实测保持待测'"'"')
