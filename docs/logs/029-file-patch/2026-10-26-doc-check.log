    for raw in re.findall(r'"'"'(?<!!)\[[^\]]*\]\(([^)]+)\)'"'"', text):
        target = raw.strip().strip('"'"'<>'"'"')
        parts = urlsplit(target)
        if parts.scheme or parts.netloc:
            continue
        dest = (path.parent / unquote(parts.path)).resolve() if parts.path else path
        assert dest.exists(), f'"'"'失效链接：{path}: {target}'"'"'
        if parts.fragment and dest.suffix == '"'"'.md'"'"':
            headings = re.findall(r'"'"'^#{1,6}\s+(.+)$'"'"', dest.read_text(encoding='"'"'utf-8'"'"'), re.M)
            slugs = []
            for heading in headings:
                clean = '"'"''"'"'.join(c for c in heading.lower() if c.isalnum() or c in '"'"' _-'"'"')
                slugs.append(re.sub(r'"'"'\s'"'"', '"'"'-'"'"', clean))
            assert unquote(parts.fragment) in slugs, f'"'"'失效标题锚点：{path}: {target}'"'"'
        checked += 1
    print(f'"'"'OK UTF-8/LF/围栏/空白/本地链接: {path.relative_to(root)} ({len(text.splitlines())} 行)'"'"')
