            assert unquote(part.fragment) in slugs, f'"'"'失效标题：{path} -> {target}'"'"'
        links += 1
    print(f'"'"'OK UTF-8/LF/空白/围栏/本地链接：{path.relative_to(root)}（{len(text.splitlines())} 行）'"'"')
