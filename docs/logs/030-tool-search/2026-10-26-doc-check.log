assert len(cases) == 19 and all('"'"'待测'"'"' in row for row in cases)
assert re.findall(r'"'"'^\| (S\d+) \|'"'"',spec,re.M) == [f'"'"'S{i:02}'"'"' for i in range(1,20)]
