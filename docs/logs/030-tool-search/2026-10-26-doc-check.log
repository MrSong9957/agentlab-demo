rows = [line.split('"'"'|'"'"')[1].strip() for line in table.splitlines() if line.startswith('"'"'|'"'"') and not line.startswith('"'"'|---'"'"')]
assert rows == ['"'"'命令执行、进程交互'"'"','"'"'文件补丁'"'"','"'"'任务计划'"'"','"'"'用户问询'"'"','"'"'执行中发消息'"'"','"'"'查看图片'"'"','"'"'MCP 外部工具'"'"','"'"'MCP 资源'"'"','"'"'工具搜索与按需加载'"'"','"'"'权限申请'"'"','"'"'上下文管理'"'"','"'"'JavaScript 工具编排'"'"','"'"'多 Agent'"'"']
