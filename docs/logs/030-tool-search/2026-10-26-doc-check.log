        assert line.rstrip() == line, f'"'"'行尾空白：{path}:{number}'"'"'
        assert not re.match(r'"'"'^(<<<<<<<|=======|>>>>>>>)'"'"', line), f'"'"'冲突标记：{path}:{number}'"'"'
