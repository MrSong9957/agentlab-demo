links = 0
for path in paths:
    data = path.read_bytes()
    text = data.decode('"'"'utf-8'"'"', errors='"'"'strict'"'"')
    assert data.endswith(b'"'"'\n'"'"') and b'"'"'\r'"'"' not in data and not text.startswith('"'"'\ufeff'"'"'), path
