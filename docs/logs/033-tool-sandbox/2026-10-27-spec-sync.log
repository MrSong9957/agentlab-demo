=== document-content-and-scope ===
cwd: /workspace
command:
python3 - <<'PY'
from pathlib import Path
import hashlib, json, re, sys, unicodedata
from urllib.parse import unquote

root = Path('/workspace')
snap = Path(Path('/tmp/tchat-033-spec-sync-current').read_text().strip())
scope = json.loads((snap / 'scope.json').read_text())
files = scope + ['docs/records/2026-10-27-sandbox-spec-sync.md']
pending = ['029-file-patch.md', '031-request-permissions.md',
           '034-javascript-tool-orchestration.md', '035-multi-agent.md']
errors = []
bt = chr(96)
fence = bt * 3
def require(condition, message):
    if not condition:
        errors.append(message)
def section(text, begin, end):
    return text.split(begin, 1)[1].split(end, 1)[0]
def first_table(text):
    rest = text.split('| 能力 | Codex 工具 | 本项目与建议 |', 1)[1].strip()
    rows = []
    for line in rest.splitlines():
        if not line.startswith('|'):
            break
        if not re.match(r'^\|[- :|]+\|$', line):
            rows.append(line.split('|')[1].strip())
    return rows
def slug(value):
    value = re.sub(r'\[([^\]]+)\]\([^)]+\)', r'\1', value)
    value = value.replace(bt, '').replace('*', '').lower()
    value = ''.join(c for c in value if c in '-_' or
                    not (unicodedata.category(c).startswith('P') or
                         unicodedata.category(c).startswith('S')))
    return value.replace(' ', '-')

for name in pending:
    rel = 'docs/specs/' + name
    old = (snap / rel).read_text()
    now = (root / rel).read_text()
    require('- 状态：待实现' in now, rel + ': status')
    require('- 更新时间：2026-10-27' in now, rel + ': date')
    headers = re.findall(r'^## \d+\..*$', now, re.M)
    require(len(headers) == 5 and headers == re.findall(r'^## \d+\..*$', old, re.M),
            rel + ': five sections changed')
    plans = re.findall(r'^\| (M\d+)\b', now, re.M)
    cases = re.findall(r'^\| ([ABCP]\d+)\s*\|', now, re.M)
    require(plans == re.findall(r'^\| (M\d+)\b', old, re.M), rel + ': plan IDs')
    require(cases == re.findall(r'^\| ([ABCP]\d+)\s*\|', old, re.M), rel + ': case IDs')
    require(all(line.endswith('| 待测 |') for line in now.splitlines()
                if re.match(r'^\| [ABCP]\d+\s*\|', line)), rel + ': case status')
    old_json = re.findall(fence + r'json\n(.*?)\n' + fence, old, re.S)
    new_json = re.findall(fence + r'json\n(.*?)\n' + fence, now, re.S)
    require(old_json == new_json, rel + ': JSON examples')
    for block in new_json:
        json.loads(block)
    for target in re.findall(r'--test\s+([a-z0-9_]+)', now):
        require((root / 'src/app/tests' / (target + '.rs')).is_file(),
                rel + ': missing test target ' + target)
    for stale in ['apply_patch_isolated', 'TCHAT_ISOLATED_TOOLS',
                  '027隔离模式下复用', '现有027隔离模式继续有效', '配套 027 身份']:
        require(stale not in now, rel + ': obsolete premise ' + stale)
    require('env -u TCHAT_SANDBOX cargo check && env -u TCHAT_SANDBOX cargo test --workspace --no-fail-fast' in now,
            rel + ': future ordinary baseline')
    print('CHECK', name, 'sections=5', 'plans=' + str(len(plans)),
          'acceptance_pending=' + str(len(cases)), 'JSON_examples_unchanged=' + str(len(new_json)))

unchanged_sections = [
    ('docs/specs/029-file-patch.md', '### 1.2 ', '### 1.5 '),
    ('docs/specs/029-file-patch.md', '### 1.6 ', '## 2. '),
    ('docs/specs/031-request-permissions.md', '### 1.4 ', '### 1.6 '),
    ('docs/specs/034-javascript-tool-orchestration.md', '### 1.3 ', '### 1.6 '),
    ('docs/specs/035-multi-agent.md', '### 1.3 ', '### 1.5 '),
]
for rel, begin, end in unchanged_sections:
    require(section((snap / rel).read_text(), begin, end) ==
            section((root / rel).read_text(), begin, end),
            rel + ': unrelated contract changed ' + begin)
for rel, marker in [('docs/specs/034-javascript-tool-orchestration.md', '### 1.7 '),
                    ('docs/specs/035-multi-agent.md', '### 1.6 ')]:
    before = section((snap / rel).read_text(), marker, '## 2.')
    after = section((root / rel).read_text(), marker, '## 2.')
    require(re.findall(r'^\|.*$', before, re.M) == re.findall(r'^\|.*$', after, re.M),
            rel + ': resource table changed')
print('CHECK contract sections and resource tables preserved')

comparison = 'docs/records/2026-10-21-codex-tools-comparison.md'
rows = first_table((root / comparison).read_text())
require(len(rows) == 13 and rows == first_table((snap / comparison).read_text()),
        'comparison capability names/order changed')
print('CHECK original comparison rows=' + str(len(rows)) + '; names/order preserved')
for name in ['029-file-patch.md', '030-tool-search.md', '031-request-permissions.md',
             '032-context-management.md', '034-javascript-tool-orchestration.md', '035-multi-agent.md']:
    require('- 状态：待实现' in (root / 'docs/specs' / name).read_text(),
            name + ': pending status lost')

link_count = 0
for rel in files:
    path = root / rel
    text = path.read_text()
    require(text.endswith('\n'), rel + ': missing final newline')
    old_lines = set((snap / rel).read_text().splitlines()) if (snap / rel).is_file() else set()
    for line_number, line in enumerate(text.splitlines(), 1):
        require(line.rstrip() == line or line in old_lines,
                rel + ': added trailing whitespace line ' + str(line_number))
    stripped = re.sub(fence + r'.*?' + fence, '', text, flags=re.S)
    stripped = re.sub(bt + r'+[^' + bt + r'\n]*' + bt + r'+', '', stripped)
    for target in re.findall(r'(?<!!)\[[^\]\n]+\]\(([^)\n]+)\)', stripped):
        if re.match(r'^[a-zA-Z][a-zA-Z0-9+.-]*:', target):
            continue
        target = target.strip('<>')
        filename, _, anchor = target.partition('#')
        destination = (path.parent / unquote(filename)).resolve() if filename else path
        link_count += 1
        require(destination.is_file(), rel + ': broken local link ' + target)
        if anchor and destination.is_file():
            headings = re.findall(r'^#{1,6}\s+(.+?)\s*#*$', destination.read_text(), re.M)
            require(unquote(anchor) in [slug(x) for x in headings],
                    rel + ': missing anchor ' + target)
print('CHECK local Markdown links/anchors=' + str(link_count))

manifest = json.loads((snap / 'manifest.json').read_text())
protected = 0
for rel, expected in manifest.items():
    if rel in scope:
        continue
    path = root / rel
    require(path.is_file() and hashlib.sha256(path.read_bytes()).hexdigest() == expected,
            'protected file modified: ' + rel)
    protected += 1
print('CHECK protected files unchanged=' + str(protected),
      '(source/tests, old logs, AGENTS, deployment materials, 030/032 included)')
for rel in scope:
    require((root / rel).read_bytes() != (snap / rel).read_bytes(),
            'expected sync missing: ' + rel)
print('CHECK edited existing files=7; no feature execution')
if errors:
    for message in errors:
        print('FAIL', message)
    sys.exit(1)
print('RESULT: documentation checks passed; feature acceptance remains pending.')
PY
